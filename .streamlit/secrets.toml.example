# Local-dev template for Streamlit secrets.
#
# Copy this file to ".streamlit/secrets.toml" (same folder) for LOCAL
# testing of the exact secrets mechanism Streamlit Cloud uses.
#
# On Streamlit Community Cloud, you do NOT upload this file — instead,
# paste the same key/value pairs into:
#   Your app -> Settings -> Secrets -> Edit secrets
# then click Save (this reboots the app with the secrets available).
#
# secrets.toml (this file, once renamed) is already covered by .gitignore
# so it will never be committed.

# RECOMMENDED — genuinely free, no credit card:
# get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY = "your-google-ai-studio-key-here"
GOOGLE_MODEL = "gemini-2.5-flash"

# Alternative paid providers (only used if GOOGLE_API_KEY isn't set):
# ANTHROPIC_API_KEY = "sk-ant-your-key-here"
# ANTHROPIC_MODEL = "claude-sonnet-4-6"
# OPENAI_API_KEY = "sk-your-key-here"
# OPENAI_MODEL = "gpt-4o-mini"
