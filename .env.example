# Copy this file to ".env" and fill in ONE of the two keys below.

# Option A: Anthropic Claude (default if set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option B: OpenAI (used only if ANTHROPIC_API_KEY is not set)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
