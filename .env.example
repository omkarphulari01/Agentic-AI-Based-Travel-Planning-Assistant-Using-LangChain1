# Copy this file to ".env" and fill in ONE of the three keys below.

# Option A (RECOMMENDED — genuinely free, no credit card):
# Google Gemini via Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# Option B: Anthropic Claude (paid, used only if GOOGLE_API_KEY is not set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option C: OpenAI (paid, used only if neither of the above is set)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
